# Backend
DATABASE_URL=sqlite:///./edtech.db
# For Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://edtech:edtech@localhost:5432/edtech
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MINUTES=10080
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000
# DEV_MODE returns email-verification / password-reset tokens in API responses
# and logs emails to console instead of sending them. Never enable in prod.
DEV_MODE=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
