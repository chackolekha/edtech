# Backend
DATABASE_URL=sqlite:///./edtech.db
# For Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://edtech:edtech@localhost:5432/edtech
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MINUTES=10080
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000
# DEV_MODE returns email-verification / password-reset tokens in API responses
# and logs emails to console instead of sending them. Never enable in prod.
DEV_MODE=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Production (compose.prod.yml on the deploy host)
#
# Neon Postgres — use the pooled endpoint; +psycopg is the SQLAlchemy driver.
#   DATABASE_URL=postgresql+psycopg://user:pw@ep-xxx-pooler.us-east-1.aws.neon.tech/edtech?sslmode=require
# Generate a real secret: openssl rand -hex 32
#   JWT_SECRET=
#   CORS_ORIGINS=https://app.example.com
# Image coordinates when pulling from ECR instead of building on the host:
#   ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
#   IMAGE_TAG=latest
# NEXT_PUBLIC_API_URL is a frontend *build* arg — it has no effect here.
